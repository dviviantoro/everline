# Copy to .env and fill in real values before `docker compose up`.
# Every value below is consumed by docker-compose.yml AND by the api
# container's own process.env — keep this the single source of truth.

# --- Postgres ---
POSTGRES_USER=everline
POSTGRES_PASSWORD=change-me-to-something-long-and-random
POSTGRES_DB=everline
# Built from the 3 values above — used by the api container to connect.
DATABASE_URL=postgresql://everline:change-me-to-something-long-and-random@postgres:5432/everline

# --- MinIO (S3-compatible object storage for PD photo evidence) ---
MINIO_ROOT_USER=everline
MINIO_ROOT_PASSWORD=change-me-to-something-else-long-and-random
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=everline
S3_SECRET_KEY=change-me-to-something-else-long-and-random
S3_BUCKET=pd-photos
# Public URL prefix photos are served from — Caddy reverse-proxies /storage/*
# to MinIO (see Caddyfile), so this is https://<whatever API_DOMAIN is set
# to below> + /storage — including if that's a sslip.io hostname or a raw
# IP (self-signed fallback), not just a real domain.
S3_PUBLIC_BASE_URL=https://api.yourdomain.com/storage

# --- API ---
PORT=3001
# Shared secret the frontend must send as the X-API-Key header on every
# request. Not real auth — see backend/README.md. Generate with:
#   openssl rand -hex 32
API_KEY=change-me-to-a-random-hex-string

# Comma-separated list of exact origins allowed to call this API —
# your Vercel production domain, any preview domains you use, and
# http://localhost:3000 for local frontend development.
CORS_ORIGIN=https://your-app.vercel.app,http://localhost:3000

# --- Caddy (reverse proxy + automatic HTTPS) ---
# The domain this API is served from — must have a DNS A record pointing
# at this VPS before `docker compose up`, or Let's Encrypt issuance fails.
#
# No domain yet, just the VPS's raw public IP? See backend/README.md,
# "Don't have a domain yet?" — recommended fix is to set this to
# <your-ip-with-dashes>.sslip.io (e.g. 203-0-113-5.sslip.io for
# 203.0.113.5), which resolves back to your IP and gets you a real,
# trusted Let's Encrypt certificate with no other changes needed. The
# fallback (self-signed, works everywhere but browsers warn on first visit)
# needs one more line below.
API_DOMAIN=api.yourdomain.com

# Uncomment to use the self-signed fallback instead of a domain (see above):
# CADDYFILE_PATH=./caddy/Caddyfile.no-domain
